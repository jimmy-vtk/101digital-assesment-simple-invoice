# Copy to .env and adjust. Never commit real secrets.
NODE_ENV=development
PORT=3000

# PostgreSQL (defaults match `docker compose up -d db`)
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=simpleinvoice
DB_PASSWORD=simpleinvoice
DB_NAME=simpleinvoice

# JWT: secret must be >= 32 chars (e.g. `openssl rand -base64 48`)
JWT_SECRET=replace-with-a-long-random-secret-of-32-chars-or-more
# Access token lifetime in seconds (default 3600)
JWT_EXPIRES_IN=3600

# Comma-separated allowed origins; empty allows any origin
CORS_ORIGIN=http://localhost:5173

# Reviewer account created by `npm run seed` (demo credentials, documented in README)
SEED_USER_EMAIL=reviewer@simpleinvoice.dev
SEED_USER_PASSWORD=Password123!
SEED_USER_FULLNAME=Reviewer
