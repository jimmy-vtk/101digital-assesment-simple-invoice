# Optional overrides for docker-compose.yml. Copy to `.env` to change them.
# Every value has a working default, so `docker compose up --build` needs no setup.

# Host ports
WEB_PORT=8080
API_PORT=3000
DB_HOST_PORT=5433

# PostgreSQL
DB_USERNAME=simpleinvoice
DB_PASSWORD=simpleinvoice
DB_NAME=simpleinvoice

# JWT: use a long random value (e.g. `openssl rand -base64 48`)
JWT_SECRET=replace-with-a-long-random-secret-of-32-chars-or-more
JWT_EXPIRES_IN=3600

# Must match the URL the web app is opened from
CORS_ORIGIN=http://localhost:8080

# Reviewer account created on start (demo credentials, documented in README;
# idempotent: set SEED_ON_START=false to skip)
SEED_ON_START=true
SEED_USER_EMAIL=reviewer@simpleinvoice.dev
SEED_USER_PASSWORD=Password123!
SEED_USER_FULLNAME=Reviewer
